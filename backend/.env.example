# Local dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobanalyzer
CORS_ORIGIN=http://localhost:5173
SCRAPE_INTERVAL_HOURS=6

# scraper/linkedin.py is deprecated (see CLAUDE.md's "Data source transition") —
# off by default. It's the only data source that currently exists, so set this
# to true if you need data flowing before P1's board-JSON/Adzuna/Jooble sources
# land. Do not extend this scraper further.
ENABLE_LINKEDIN_SCRAPER=false

# Production (Railway)
# DATABASE_URL=<provided by Railway Postgres plugin>
# CORS_ORIGIN=https://jobs.amaansiddiqi.me
# SCRAPE_INTERVAL_HOURS=6
# ENABLE_LINKEDIN_SCRAPER=false
