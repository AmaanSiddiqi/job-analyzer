# Local dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobanalyzer
CORS_ORIGIN=http://localhost:5173
SCRAPE_INTERVAL_HOURS=6

# scraper/linkedin.py is deprecated (see CLAUDE.md's "Data source transition") —
# off by default. It's the only data source that currently exists, so set this
# to true if you need data flowing before P1's board-JSON/Adzuna/Jooble sources
# land. Do not extend this scraper further.
ENABLE_LINKEDIN_SCRAPER=false

# P1 board-JSON ingestion (Greenhouse/Lever/Ashby from sources/companies.yaml).
# Off by default — flipping this in Railway is the supervised go-live step.
# Runs on the scheduler every BOARD_INGEST_INTERVAL_HOURS and via the
# admin-gated POST /ingest/boards.
ENABLE_BOARD_INGESTION=false
# BOARD_INGEST_INTERVAL_HOURS=6
# BOARD_CANADA_ONLY=true    # drop listings with clearly non-Canadian locations
# BOARD_FETCH_CONCURRENCY=4

# Shared-secret gate for POST /jobs, POST /scrape, POST /scrape/bulk (AUDIT.md
# §1) — required header X-Admin-Key. Generate a real value with e.g.
# `python3 -c "import secrets; print(secrets.token_hex(24))"`. Unset = those
# routes 503 rather than staying open, so set this in every environment.
ADMIN_API_KEY=

# eval/scripts/draft_label.py only (annotator model for machine-assisted gold
# labeling, see backend/eval/README.md) — not used by the running app.
# ANTHROPIC_API_KEY=

# Production (Railway)
# DATABASE_URL=<provided by Railway Postgres plugin>
# CORS_ORIGIN=https://jobs.amaansiddiqi.me
# SCRAPE_INTERVAL_HOURS=6
# ENABLE_LINKEDIN_SCRAPER=false
# ADMIN_API_KEY=<generate a real secret, set in Railway>
